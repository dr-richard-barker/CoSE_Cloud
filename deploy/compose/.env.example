# Copy to .env (git-ignored) and edit. Nothing here is a real secret until you set it.
POSTGRES_PASSWORD=change-me-postgres
# first admin, created by the seed profile; the password is read here, never from the command line
COSE_ADMIN_EMAIL=admin@example.org
COSE_ADMIN_PASSWORD=change-me-at-least-12-chars
# CoSE_Agent for the HQ org: off | local | hosted
COSE_LLM_MODE=off
# hosted only: monthly cap in USD for this org (no cap = no hosted calls), plus the API key
COSE_LLM_CAP=
ANTHROPIC_API_KEY=
# local only: an OpenAI-style server (e.g. Ollama on the host) and the model name
COSE_LOCAL_LLM_URL=http://host.docker.internal:11434/v1
COSE_LOCAL_LLM_MODEL=
# CoSE-wide hosted spend cap per month (all orgs), and the off switch
COSE_LLM_GLOBAL_MONTHLY_CAP_USD=50
COSE_LLM_KILL_SWITCH=false
# bind addresses: 127.0.0.1 keeps everything on this machine; 0.0.0.0 opens it to the HQ network
HTTP_BIND=127.0.0.1
MQTT_BIND=127.0.0.1
COSE_BACKFILL_DAYS=6
