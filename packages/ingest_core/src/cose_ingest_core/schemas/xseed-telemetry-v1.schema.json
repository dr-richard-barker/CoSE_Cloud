{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosecloud.com/schemas/xseed/telemetry/v1",
  "title": "XSeed telemetry (cose/v1/devices/{uuid}/telemetry)",
  "description": "Published every 5 s (doc 06 §5.1, §8). Generated by firmware/src/telemetry.cpp; firmware/check.py validates every payload the host tests emit. Missing readings are null, never omitted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["device_id", "timestamp", "firmware_version", "crop_profile", "growth_day", "stage",
               "light_phase", "sensors", "biometrics_3d", "actuators", "alerts"],
  "properties": {
    "device_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "integer", "minimum": 0},
    "firmware_version": {"type": "string", "minLength": 1},
    "crop_profile": {"type": "string", "enum": ["broccoli", "radish", "sunflower", "pea", "arugula", "basil", "test"]},
    "growth_day": {"type": "number", "minimum": 0},
    "stage": {"type": "string", "enum": ["germination", "emergence", "peak_vegetative", "finishing", "harvest_ready"]},
    "light_phase": {"type": "integer", "minimum": 0, "maximum": 3},
    "sensors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dome_temp_c", "dome_humidity_pct", "root_temp_c", "water_basin_temp_c",
                   "heater_plate_temp_c", "water_level_ok", "vpd_kpa"],
      "properties": {
        "dome_temp_c": {"type": ["number", "null"], "minimum": -20, "maximum": 80},
        "dome_humidity_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "root_temp_c": {"type": ["number", "null"], "minimum": -20, "maximum": 80},
        "water_basin_temp_c": {"type": ["number", "null"], "minimum": -20, "maximum": 80},
        "heater_plate_temp_c": {"type": ["number", "null"], "minimum": -20, "maximum": 150},
        "water_level_ok": {"type": "boolean"},
        "vpd_kpa": {"type": ["number", "null"], "minimum": 0, "maximum": 10}
      }
    },
    "biometrics_3d": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "canopy_height_avg_mm", "canopy_height_max_mm", "canopy_uniformity_idx",
                   "biomass_volume_cm3", "growth_rate_mm_day", "tof_matrix_64"],
      "properties": {
        "valid": {"type": "boolean"},
        "canopy_height_avg_mm": {"type": ["number", "null"], "minimum": 0, "maximum": 400},
        "canopy_height_max_mm": {"type": ["number", "null"], "minimum": 0, "maximum": 400},
        "canopy_uniformity_idx": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "biomass_volume_cm3": {"type": ["number", "null"], "minimum": 0},
        "growth_rate_mm_day": {"type": ["number", "null"]},
        "tof_matrix_64": {"type": "array", "minItems": 64, "maxItems": 64,
                          "items": {"type": ["number", "null"], "minimum": 0, "maximum": 400}}
      }
    },
    "actuators": {
      "type": "object",
      "additionalProperties": false,
      "required": ["led_pwm_pct", "led_power_w", "heater_pwm_pct", "heater_relay",
                   "fan_intake_pwm_pct", "fan_exhaust_pwm_pct", "pump_state"],
      "properties": {
        "led_pwm_pct": {
          "type": "object",
          "additionalProperties": false,
          "required": ["w", "r", "b", "fr"],
          "properties": {
            "w": {"type": "number", "minimum": 0, "maximum": 100},
            "r": {"type": "number", "minimum": 0, "maximum": 100},
            "b": {"type": "number", "minimum": 0, "maximum": 100},
            "fr": {"type": "number", "minimum": 0, "maximum": 100}
          }
        },
        "led_power_w": {"type": "number", "minimum": 0, "maximum": 24.01},
        "heater_pwm_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "heater_relay": {"type": "boolean"},
        "fan_intake_pwm_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "fan_exhaust_pwm_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "pump_state": {"type": "string", "enum": ["IDLE", "FLOOD"]}
      }
    },
    "alerts": {
      "type": "array",
      "items": {"type": "string", "enum": ["heater_trip", "sensor_lost", "water_low", "water_hot", "fan_fault",
                                            "canopy_anomaly", "canopy_near_led", "harvest_ready"]}
    }
  }
}
